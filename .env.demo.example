# The offline demo stack (docker-compose.demo.yml). `make demo-env` copies this file to
# .env.demo (gitignored) and replaces every value marked `generate` with a fresh random one.
# Nothing is printed. Delete .env.demo and run `make demo-env` again for new keys (then
# `make demo-reset`: the database was created with the old passwords).
#
# The fixed demo settings are not here: docker-compose.demo.yml sets them itself
# (DEMO_MODE=1, DJANGO_DEBUG=0, DJANGO_SSL_REDIRECT=0, DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,
# OTP_SENDER=demo.sender.DemoInboxOtpSender), so this file cannot switch demo mode off or on.

# Database passwords, used only inside the stack's private network (the db is not published).
# Postgres superuser: creates the two roles on first start; reaches only the db container.
POSTGRES_SUPERUSER_PASSWORD=generate
# gj_owner: owns the schema and runs migrations (the backend entrypoint only).
GJ_OWNER_PASSWORD=generate
# gj_app: the running app; cannot change the schema or bypass row-level security.
GJ_APP_PASSWORD=generate

# Django and field-encryption keys (random URL-safe text; the field key is a Fernet key).
DJANGO_SECRET_KEY=generate
FIELD_ENCRYPTION_KEY=generate
BLIND_INDEX_KEY=generate
OTP_HMAC_KEY=generate

# The one shared password of the synthetic demo accounts. Not a secret: the persona picker
# shows it. Never reuse it anywhere real. It must pass the password rules (12+ characters).
DEMO_PASSWORD=Sabarmati-Demo-2026
